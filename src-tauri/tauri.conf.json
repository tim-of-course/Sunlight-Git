{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sunlight",
  "version": "0.1.0",
  "identifier": "com.sunlight.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sunlight",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM4N0ExRkE1ODlCMzQ1RjUKUldUMVJiT0pwUjk2eUlBenNxaitDbWh5ZWF6VFpNRzRFdk03ekpJektlcHF2UzlpbDgrcUxaSmUK",
      "endpoints": [
        "https://github.com/tim-of-course/Sunlight-Git/releases/latest/download/latest.json"
      ]
    }
  }
}
